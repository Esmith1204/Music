# Copy to .env.local (gitignored) and fill in from the Supabase dashboard:
# "Connect" button, or Project Settings → API Keys.
# Use the publishable key (VITE_SUPABASE_ANON_KEY with the legacy anon key also works),
# never the service_role/secret key.
# Restart `npm run dev` after editing.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
